        <!-- workflow chaining -->
        <mxCell id="e_chain" value="&lt;b&gt;workflow_run&lt;/b&gt;&#160;&#160;types: [completed]&#160;&#160;·&#160;&#160;runs only if conclusion == 'success'"
          style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#24292E;strokeWidth=3;fontColor=#24292E;fontSize=11;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="a6" target="c1">
